# ===================================================
# Library Management System - Environment Configuration
# ===================================================
# Copy this file to .env and adjust variables as needed:
#   cp .env.example .env

# --- PostgreSQL Database Credentials ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=library_db
POSTGRES_HOST=postgres
# (Optional) Direct database connection string. If omitted, constructed automatically.
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/library_db

# --- Celery & Redis Task Queue Configuration ---
# In Docker Compose, the redis service hostname is "redis"
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
# When running backend locally without Docker, use localhost:
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/0

# --- JWT Authentication & Security ---
# Secret key used for signing JWT tokens (Change this in production!)
JWT_SECRET_KEY=super-secret-library-key-change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Frontend API Endpoint ---
# Used by the Vite frontend build or dev server
VITE_API_BASE=http://localhost:8000
